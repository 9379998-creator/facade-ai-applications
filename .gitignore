# .gitignore for Facade AI Applications

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# IDE and Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Temporary and cache
tmp/
temp/
.cache/
*.tsbuildinfo
